<?php defined('BASEPATH') OR exit('No direct script access allowed');
$companyName = isset($settings['company_name']) && $settings['company_name'] !== '' ? $settings['company_name'] : 'Công ty TNHH MTV Cao su Chư Sê';
$publicSuccess = (string) $this->session->flashdata('public_success');
$publicError = (string) $this->session->flashdata('public_error');
$slogan = isset($settings['slogan']) ? $settings['slogan'] : '';
$hotline = isset($settings['hotline']) && $settings['hotline'] !== '' ? $settings['hotline'] : (isset($settings['phone']) ? $settings['phone'] : '');
$safeUrl = function ($url) {
	$url = trim((string) $url);
	return preg_match('~^(https?://|/|#)~i', $url) ? $url : '#';
};
$renderMenu = NULL;
$renderMenu = function ($items) use (&$renderMenu, $safeUrl) {
	foreach ($items as $item):
		$children = isset($item['children']) ? $item['children'] : array();
		?><li<?php echo ! empty($children) ? ' class="has-children"' : ''; ?>><a href="<?php echo html_escape($safeUrl($item['url'])); ?>"<?php echo $item['target'] === '_blank' ? ' target="_blank" rel="noopener"' : ''; ?>><?php echo html_escape($item['title']); ?><?php echo ! empty($children) ? ' <span aria-hidden="true">⌄</span>' : ''; ?></a><?php if (! empty($children)): ?><ul><?php $renderMenu($children); ?></ul><?php endif; ?></li><?php endforeach;
};
$mainSections = array_merge(isset($sections['main']) ? $sections['main'] : array(), isset($sections['full']) ? $sections['full'] : array());
$supportSections = array_merge(isset($sections['left']) ? $sections['left'] : array(), isset($sections['right']) ? $sections['right'] : array());
$sliderSection = NULL;
foreach ($mainSections as $section) { if ($section['section_type'] === 'slider') { $sliderSection = $section; break; } }
$heroSlide = ! empty($slider) ? $slider[0] : NULL;
?>
<!DOCTYPE html>
<html lang="vi">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><?php echo html_escape($page_title); ?></title>
	<meta name="description" content="<?php echo html_escape(isset($settings['meta_description']) ? $settings['meta_description'] : ''); ?>">
	<link rel="stylesheet" href="<?php echo base_url('assets/css/site.css'); ?>">
</head>
<body>
	<?php if ($publicSuccess !== '' || $publicError !== ''): ?><div class="site-alert <?php echo $publicError !== '' ? 'site-alert-error' : ''; ?>" role="status"><?php echo html_escape($publicError !== '' ? $publicError : $publicSuccess); ?></div><?php endif; ?>
	<header class="site-header">
		<div class="utility-bar"><div class="container utility-inner"><span><?php echo html_escape($slogan !== '' ? $slogan : 'Phát triển bền vững từ vùng đất Chư Sê'); ?></span><span><?php echo $hotline !== '' ? 'Hotline: ' . html_escape($hotline) : ''; ?></span></div></div>
		<div class="container navigation">
			<a class="brand" href="<?php echo site_url(); ?>" aria-label="Trang chủ <?php echo html_escape($companyName); ?>"><img src="<?php echo base_url(isset($settings['logo_path']) && $settings['logo_path'] !== '' ? $settings['logo_path'] : 'assets/images/logo.png'); ?>" alt="Logo <?php echo html_escape($companyName); ?>"><span><strong><?php echo html_escape($companyName); ?></strong><small><?php echo html_escape(isset($settings['group_name']) ? $settings['group_name'] : 'Công ty TNHH MTV'); ?></small></span></a>
			<nav class="site-nav" aria-label="Điều hướng chính"><ul><?php $renderMenu($mainMenu); ?></ul></nav>
		</div>
	</header>

	<main>
		<section class="hero<?php echo $heroSlide !== NULL ? ' hero-image' : ''; ?>"<?php echo $heroSlide !== NULL ? ' style="background-image: url(\'' . html_escape(base_url($heroSlide['image_path'])) . '\');"' : ''; ?>><div class="hero-pattern"></div><div class="container hero-content"><p class="eyebrow"><?php echo html_escape($companyName); ?></p><?php if ($heroSlide !== NULL): ?><h1><?php echo nl2br(html_escape($heroSlide['title'])); ?></h1><p class="hero-copy"><?php echo html_escape($heroSlide['subtitle']); ?></p><?php if ($heroSlide['link_url']): ?><a class="button button-light" href="<?php echo html_escape($safeUrl($heroSlide['link_url'])); ?>">Khám phá <span aria-hidden="true">→</span></a><?php endif; ?><?php else: ?><h1><?php echo html_escape($slogan !== '' ? $slogan : $companyName); ?></h1><?php endif; ?></div><div class="hero-note">01 <span></span> <?php echo html_escape($companyName); ?></div></section>

		<?php foreach ($mainSections as $section): if ($section['section_type'] === 'slider') continue; $items = isset($sectionItems[$section['id']]) ? $sectionItems[$section['id']] : array(); ?>
		<section class="section dynamic-section dynamic-<?php echo html_escape($section['section_type']); ?>"><div class="container"><div class="section-label"><?php echo html_escape($section['title']); ?></div><div class="section-heading-row"><h2><?php echo html_escape($section['title']); ?></h2><?php if ($section['subtitle']): ?><p><?php echo html_escape($section['subtitle']); ?></p><?php endif; ?></div><?php if ($section['section_type'] === 'html'): ?><div class="dynamic-html"><?php echo $section['content_html']; ?></div><?php elseif ($section['section_type'] === 'image' && $section['image_path']): ?><img class="dynamic-banner" src="<?php echo html_escape(base_url($section['image_path'])); ?>" alt="<?php echo html_escape($section['title']); ?>"><?php elseif ($section['section_type'] === 'content'): ?><div class="dynamic-content-grid"><?php foreach ($items as $item): ?><article class="dynamic-content-card"><?php if (! empty($item['cover_path'])): ?><img src="<?php echo html_escape(base_url($item['cover_path'])); ?>" alt="<?php echo html_escape($item['title']); ?>" loading="lazy"><?php endif; ?><p class="card-meta"><?php echo html_escape($section['category_name'] ? $section['category_name'] : $section['source_resource']); ?></p><h3><?php echo html_escape($item['title']); ?></h3><a class="text-link" href="<?php echo site_url('trang/' . $item['slug']); ?>">Xem chi tiết <span aria-hidden="true">↗</span></a></article><?php endforeach; ?></div><?php endif; ?><?php if ($section['link_url'] && $section['link_label']): ?><a class="text-link" href="<?php echo html_escape($safeUrl($section['link_url'])); ?>"><?php echo html_escape($section['link_label']); ?> <span aria-hidden="true">↗</span></a><?php endif; ?></div></section>
		<?php endforeach; ?>

		<?php if (! empty($supportSections)): ?><section class="support-section"><div class="container"><div class="support-grid"><?php foreach ($supportSections as $section): $items = isset($sectionItems[$section['id']]) ? $sectionItems[$section['id']] : array(); ?><article class="support-card"><p class="section-label"><?php echo html_escape($section['title']); ?></p><?php if ($section['section_type'] === 'html'): ?><div class="dynamic-html"><?php echo $section['content_html']; ?></div><?php elseif ($section['section_type'] === 'image' && $section['image_path']): ?><img src="<?php echo html_escape(base_url($section['image_path'])); ?>" alt="<?php echo html_escape($section['title']); ?>" loading="lazy"><?php else: ?><ul><?php foreach ($items as $item): ?><li><a href="<?php echo site_url('trang/' . $item['slug']); ?>"><?php echo html_escape($item['title']); ?></a></li><?php endforeach; ?></ul><?php endif; ?></article><?php endforeach; ?></div></div></section><?php endif; ?>

		<section class="news-section"><div class="container"><div class="section-label">Tin tức & hoạt động</div><div class="section-heading-row"><h2>Câu chuyện<br><em>mỗi ngày.</em></h2><a class="text-link" href="<?php echo site_url('tin-tuc'); ?>">Xem tất cả tin tức <span aria-hidden="true">↗</span></a></div><div class="news-grid"><?php if (empty($news)): ?><p class="muted">Chưa có tin tức đã xuất bản.</p><?php else: ?><?php foreach ($news as $item): ?><article class="news-item"><p>Tin tức <span><?php echo html_escape($item['published_at'] ? date('d/m/Y', strtotime($item['published_at'])) : ''); ?></span></p><h3><?php echo html_escape($item['title']); ?></h3><a href="<?php echo site_url('trang/' . $item['slug']); ?>" aria-label="Đọc <?php echo html_escape($item['title']); ?>">Đọc tiếp <span aria-hidden="true">↗</span></a></article><?php endforeach; ?><?php endif; ?></div></div></section>
	</main>

	<footer class="site-footer"><div class="container footer-top"><div><p class="eyebrow"><?php echo html_escape($companyName); ?></p><h2><?php echo html_escape(isset($settings['footer_title']) && $settings['footer_title'] !== '' ? $settings['footer_title'] : 'Cùng tạo nên giá trị bền vững.'); ?></h2></div><div class="footer-contact"><p>Liên hệ với chúng tôi</p><strong><?php echo html_escape(isset($settings['address']) ? $settings['address'] : ''); ?></strong><?php if (! empty($settings['phone'])): ?><a href="tel:<?php echo html_escape($settings['phone']); ?>"><?php echo html_escape($settings['phone']); ?></a><?php endif; ?><?php if (! empty($settings['email'])): ?><a href="mailto:<?php echo html_escape($settings['email']); ?>"><?php echo html_escape($settings['email']); ?></a><?php endif; ?></div><form class="newsletter-form" method="post" action="<?php echo site_url('dang-ky-nhan-tin'); ?>"><?php echo form_hidden($this->security->get_csrf_token_name(), $this->security->get_csrf_hash()); ?><label for="newsletter-email">Đăng ký nhận tin</label><div><input id="newsletter-email" type="email" name="email" placeholder="Email của bạn" required><button type="submit">Đăng ký</button></div></form></div><div class="container footer-links"><div><span>Liên kết nhanh</span><ul><?php $renderMenu($footerMenu); ?></ul></div></div><div class="container footer-bottom"><span>© <?php echo date('Y'); ?> <?php echo html_escape($companyName); ?></span><span>Thông tin được cập nhật từ hệ thống quản trị</span></div></footer>
</body>
</html>